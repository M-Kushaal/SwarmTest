# ============================================================
# TestSwarm secrets
# 1. Copy this file and rename the copy to:  .env
# 2. Fill in your real values in .env
# 3. NEVER share or commit .env (it is git-ignored; this .example file is safe to share)
# ============================================================

# --- Required for real runs: your Anthropic API key (https://console.anthropic.com) ---
# (Not needed for `python -m testswarm demo`.)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# --- Optional: login details for the website being tested ---
# Any variable starting with TESTSWARM_SECRET_ becomes a placeholder the agent can type:
#   TESTSWARM_SECRET_PASSWORD  ->  {{PASSWORD}}
# The AI only ever sees "{{PASSWORD}}". The real value is swapped in by code at the
# moment of typing, and masked in all logs and reports. Use a TEST account.
#
# The values below are the PUBLIC demo login of https://www.saucedemo.com, used by the
# example "shopper" persona in personas.yaml. Replace them with your own test account.
TESTSWARM_SECRET_USERNAME=standard_user
TESTSWARM_SECRET_PASSWORD=secret_sauce
